{
  "name": "scrabble-dictionary",
  "version": "1.3.0",
  "description": "Scrabble word lists, tile distributions and common-word frequency lists for multiple languages, as plain text and JSON data files.",
  "files": [
    "reference.json",
    "*/*.txt",
    "*/tiles.json"
  ],
  "keywords": [
    "scrabble",
    "dictionary",
    "wordlist",
    "tiles",
    "words",
    "game",
    "frequency"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlandersBurger/scrabble-dictionary.git"
  },
  "homepage": "https://github.com/FlandersBurger/scrabble-dictionary#readme",
  "bugs": {
    "url": "https://github.com/FlandersBurger/scrabble-dictionary/issues"
  },
  "scripts": {
    "validate": "node scripts/validate.js",
    "bump-versions": "node scripts/bump-versions.js",
    "build-frequency": "node scripts/build-frequency.js",
    "sort-lists": "node scripts/sort-lists.js",
    "import-lists": "node scripts/import-lists.js"
  }
}
